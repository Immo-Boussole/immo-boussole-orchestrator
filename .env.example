# ─────────────────────────────────────────────
# Immo-Boussole Orchestrator — Environment Config
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────

# ── Security ──────────────────────────────────
# Strong random secret for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret

# ── Web UI Authentication (HTTP Basic) ────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Server ────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=9000

# ── MCP Server ────────────────────────────────
MCP_PORT=9001

# ── Instances Registry ────────────────────────
# Path to the YAML file listing all Immo-Boussole instances
INSTANCES_FILE=instances.yaml

# ── Notifications — Webhook ───────────────────
# Generic JSON webhook URL (leave empty to disable)
NOTIFICATION_WEBHOOK_URL=

# ── Notifications — Email (SMTP) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=orchestrator@example.com
# Comma-separated list of recipients
SMTP_TO=admin@example.com
SMTP_USE_TLS=true

# ── Health Poller ─────────────────────────────
# Interval in seconds between health checks
HEALTH_POLL_INTERVAL=30

# ── Debug ─────────────────────────────────────
DEBUG=false
